<?xml version="1.0" encoding="utf-8"?>
<!-- USB devices that launch MoldSign on attach (ACTION_USB_DEVICE_ATTACHED). -->
<resources>
    <!-- Any CCID smart-card reader: interface class 0x0B (UsbDeviceFilter also matches interface classes). -->
    <usb-device class="11" />

    <!-- bit4id (miniLector POCKET EVO). TODO(AND-03): verify vendor id 0x25DD (= 9693) and add the
         product id on a real device (`adb shell dumpsys usb` / lsusb). Some bit4id firmwares expose
         a vendor-specific interface class instead of 0x0B, which this entry still catches. -->
    <usb-device vendor-id="9693" />
</resources>
