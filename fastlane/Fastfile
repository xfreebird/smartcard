# eSemnBun Apple signing (docs/11): match keeps the certificates and profiles in the storage repo (Matchfile).
# Local (owner): `bundle exec fastlane certs` creates what is missing. CI: the lanes below fetch read-only.
# Credentials only from the environment, see fastlane/SIGNING.md.
default_platform(:ios)

IOS_ID = "md.esemnbun.ios"
MAC_ID = "md.esemnbun.mac"
PROJECT = File.expand_path("../apple/eSemnBun.xcodeproj", __dir__)

# App Store Connect API key: ASC_KEY_ID + ASC_ISSUER_ID + (ASC_KEY_P8 content | ASC_KEY_PATH file).
def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV["ASC_KEY_P8"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false
  )
end

desc "Register the App IDs md.esemnbun.ios and md.esemnbun.mac (idempotent)"
lane :register_ids do
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_key)
  { IOS_ID => ["eSemnBun iOS", Spaceship::ConnectAPI::Platform::IOS],
    MAC_ID => ["eSemnBun macOS", Spaceship::ConnectAPI::Platform::MAC_OS] }.each do |identifier, (name, platform)|
    if Spaceship::ConnectAPI::BundleId.find(identifier)
      UI.message("#{identifier} already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: platform)
      UI.success("Registered #{identifier}")
    end
  end
end

desc "DESTRUCTIVE: revoke every certificate and delete every profile of the team. Local only"
lane :nuke_all do
  UI.user_error!("nuke_all never runs in CI") if is_ci
  key = asc_key
  # developer_id is left out: match_nuke 2.241 fails on it ("Unknown cert type: developer_id_application");
  # revoke Developer ID certificates in the developer portal if ever needed.
  [%w[development ios], %w[appstore ios], %w[adhoc ios], %w[development macos], %w[appstore macos]].each do |type, platform|
    match_nuke(type: type, platform: platform, api_key: key, skip_confirmation: true)
  end
end

desc "Create what is missing (owner, local): App IDs, iOS App Store + development profiles and certificates"
lane :certs do
  UI.user_error!("certs writes to the storage repo; CI only reads (ios_release, mac_signing)") if is_ci
  register_ids
  key = asc_key
  match(type: "appstore", platform: "ios", app_identifier: IOS_ID, api_key: key, readonly: false)
  match(type: "development", platform: "ios", app_identifier: IOS_ID, api_key: key, readonly: false)
  match(type: "adhoc", platform: "ios", app_identifier: IOS_ID, api_key: key, readonly: false)   # registered devices
  # Developer ID can't be created with an API key ("can only be performed by the Account Holder"):
  # create it in the portal from a CSR, then `fastlane import_developer_id cer:… key:…`.
end

desc "Regenerate the ad hoc profile with every device registered in the portal (then run a new build)"
lane :new_devices do
  UI.user_error!("new_devices writes to the storage repo; run it locally") if is_ci
  match(type: "adhoc", platform: "ios", app_identifier: IOS_ID, api_key: asc_key, readonly: false,
        force_for_new_devices: true)
end

desc "Store a portal-made Developer ID Application certificate in match (cer: downloaded .cer, key: CSR private key; or p12:)"
lane :import_developer_id do |options|
  UI.user_error!("import_developer_id writes to the storage repo; run it locally") if is_ci
  cer = File.expand_path(options.fetch(:cer))
  p12 = options[:p12] ? File.expand_path(options[:p12]) : cer.sub(/\.cer\z/, ".p12")
  unless options[:p12]
    # The .p12 must come from the macOS keychain: OpenSSL encodes an empty password differently, and `security
    # import` then fails with "MAC verification failed" (or "Unknown format" without a MAC).
    require "securerandom"
    require "tmpdir"
    dir = Dir.mktmpdir
    keychain = File.join(dir, "import.keychain-db")
    password = SecureRandom.hex(8)
    sh("security", "create-keychain", "-p", password, keychain, log: false)
    begin
      sh("security", "unlock-keychain", "-p", password, keychain, log: false)
      sh("security", "import", File.expand_path(options.fetch(:key)), "-k", keychain, "-T", "/usr/bin/codesign")
      sh("security", "import", cer, "-k", keychain)
      UI.important("macOS asks to allow exporting the key from the throwaway keychain: its password is #{password}")
      sh("security", "export", "-k", keychain, "-t", "identities", "-f", "pkcs12", "-P", "", "-o", p12)
    ensure
      sh("security", "delete-keychain", keychain, log: false)
      FileUtils.rm_rf(dir)
    end
  end
  # `fastlane match import` only takes the file paths interactively: call its importer directly
  require "match"
  params = FastlaneCore::Configuration.create(Match::Options.available_options, {
    type: "developer_id", platform: "macos", app_identifier: [MAC_ID], api_key: asc_key, readonly: false
  })
  params.load_configuration_file("Matchfile")
  Match::Importer.new.import_cert(params, cert_path: cer, p12_path: p12, profile_path: "")
end

desc "Install the Developer ID identity (CI: temporary keychain) for scripts/package-macos.sh"
lane :mac_signing do
  setup_ci if is_ci
  # no provisioning profile: the unsandboxed app only uses the smart-card entitlement
  match(type: "developer_id", platform: "macos", app_identifier: MAC_ID, api_key: asc_key, readonly: true,
        skip_provisioning_profiles: true)
end

desc "iOS: one archive → App Store IPA (uploaded to TestFlight, not waiting for processing) + ad hoc IPA in dist/ios"
lane :ios_release do |options|
  setup_ci if is_ci
  key = asc_key
  match(type: "appstore", platform: "ios", app_identifier: IOS_ID, api_key: key, readonly: true)
  match(type: "adhoc", platform: "ios", app_identifier: IOS_ID, api_key: key, readonly: true)
  team = ENV["sigh_#{IOS_ID}_appstore_team-id"]
  appstore_profile = ENV["sigh_#{IOS_ID}_appstore_profile-name"]
  adhoc_profile = ENV["sigh_#{IOS_ID}_adhoc_profile-name"]
  out = File.expand_path("../dist/ios", __dir__)
  archive = File.join(out, "eSemnBun-iOS.xcarchive")
  # the project also has macOS targets: pin the platform or gym exports with the Mac installer method
  common = { project: PROJECT, scheme: "eSemnBun-iOS", configuration: "Release", destination: "generic/platform=iOS",
             sdk: "iphoneos", export_team_id: team, output_directory: out, archive_path: archive }
  pbxproj = File.join(PROJECT, "project.pbxproj")
  original = File.read(pbxproj)
  begin
    # Target-scoped signing: command-line overrides would also hit the SwiftPM package targets.
    update_code_signing_settings(path: PROJECT, use_automatic_signing: false, targets: ["eSemnBun-iOS"],
                                 build_configurations: ["Release"], team_id: team, profile_name: appstore_profile,
                                 code_sign_identity: "Apple Distribution")
    version = get_version_number(xcodeproj: PROJECT, target: "eSemnBun-iOS", configuration: "Release")
    build_app(**common, export_method: "app-store", export_options: { provisioningProfiles: { IOS_ID => appstore_profile } },
              output_name: "eSemnBun-#{version}-appstore.ipa", clean: true,
              xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}")
    # same archive, re-signed with the ad hoc profile: installs on the team's registered devices
    build_app(**common, skip_build_archive: true, export_method: "ad-hoc",
              export_options: { provisioningProfiles: { IOS_ID => adhoc_profile } },
              output_name: "eSemnBun-#{version}-adhoc.ipa")
  ensure
    File.write(pbxproj, original)   # never leave manual-signing edits in the committed project
  end
  upload = options.key?(:upload) ? options[:upload].to_s != "false" : is_ci
  if upload
    # returns as soon as App Store Connect has the binary; processing continues on Apple's side
    upload_to_testflight(api_key: key, ipa: File.join(out, "eSemnBun-#{version}-appstore.ipa"),
                         skip_waiting_for_build_processing: true, skip_submission: true)
  end
end
