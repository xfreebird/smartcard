# eSemnBun Apple signing (docs/11): match keeps the certificates and profiles in the storage repo (Matchfile).
# Local (owner): `bundle exec fastlane certs` creates what is missing. CI: the lanes below fetch read-only.
# Credentials only from the environment, see fastlane/SIGNING.md.
default_platform(:ios)

IOS_ID = "md.esemnbun.ios"
IOS_SHARE_ID = "md.esemnbun.ios.share"
IOS_IDS = [IOS_ID, IOS_SHARE_ID]
MAC_ID = "md.esemnbun.mac"
PROJECT = File.expand_path("../apple/eSemnBun.xcodeproj", __dir__)

# Build identity is a whole number; marketing versions remain x.y.z.
def integer_build_number
  value = ENV.fetch("BUILD_NUMBER", "1")
  UI.user_error!("BUILD_NUMBER must be a positive whole number") unless value.match?(/\A[1-9][0-9]*\z/)
  value
end

# App Store Connect API key: ASC_KEY_ID + ASC_ISSUER_ID + (ASC_KEY_P8 content | ASC_KEY_PATH file).
def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV["ASC_KEY_P8"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false
  )
end

desc "Register the App IDs md.esemnbun.ios and md.esemnbun.mac (idempotent)"
lane :register_ids do
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_key)
  { IOS_ID => ["eSemnBun iOS", Spaceship::ConnectAPI::Platform::IOS],
    IOS_SHARE_ID => ["eSemnBun Share", Spaceship::ConnectAPI::Platform::IOS],
    MAC_ID => ["eSemnBun macOS", Spaceship::ConnectAPI::Platform::MAC_OS] }.each do |identifier, (name, platform)|
    if Spaceship::ConnectAPI::BundleId.find(identifier)
      UI.message("#{identifier} already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: platform)
      UI.success("Registered #{identifier}")
    end
  end
end

desc "DESTRUCTIVE: revoke every certificate and delete every profile of the team. Local only"
lane :nuke_all do
  UI.user_error!("nuke_all never runs in CI") if is_ci
  key = asc_key
  # developer_id is left out: match_nuke 2.241 fails on it ("Unknown cert type: developer_id_application");
  # revoke Developer ID certificates in the developer portal if ever needed.
  [%w[development ios], %w[appstore ios], %w[adhoc ios], %w[development macos], %w[appstore macos]].each do |type, platform|
    match_nuke(type: type, platform: platform, api_key: key, skip_confirmation: true)
  end
end

desc "Create what is missing (owner, local): App IDs, iOS App Store + development profiles and certificates"
lane :certs do |options|
  UI.user_error!("certs writes to the storage repo; CI only reads (ios_release, mac_signing)") if is_ci
  register_ids
  key = asc_key
  refresh = options[:force].to_s == "true"
  match(type: "appstore", platform: "ios", app_identifier: IOS_IDS, api_key: key, readonly: false, force: refresh)
  match(type: "development", platform: "ios", app_identifier: IOS_IDS, api_key: key, readonly: false, force: refresh)
  match(type: "adhoc", platform: "ios", app_identifier: IOS_IDS, api_key: key, readonly: false, force: refresh)   # registered devices
  # Developer ID can't be created with an API key ("can only be performed by the Account Holder"):
  # create it in the portal from a CSR, then `fastlane import_developer_id cer:… key:…`.
end

desc "Regenerate the ad hoc profile with every device registered in the portal (then run a new build)"
lane :new_devices do
  UI.user_error!("new_devices writes to the storage repo; run it locally") if is_ci
  match(type: "adhoc", platform: "ios", app_identifier: IOS_IDS, api_key: asc_key, readonly: false,
        force_for_new_devices: true)
end

desc "Store a portal-made Developer ID Application certificate in match (cer: downloaded .cer, key: CSR private key; or p12:)"
lane :import_developer_id do |options|
  UI.user_error!("import_developer_id writes to the storage repo; run it locally") if is_ci
  cer = File.expand_path(options.fetch(:cer))
  p12 = options[:p12] ? File.expand_path(options[:p12]) : cer.sub(/\.cer\z/, ".p12")
  unless options[:p12]
    # The .p12 must come from the macOS keychain: OpenSSL encodes an empty password differently, and `security
    # import` then fails with "MAC verification failed" (or "Unknown format" without a MAC).
    require "securerandom"
    require "tmpdir"
    dir = Dir.mktmpdir
    keychain = File.join(dir, "import.keychain-db")
    password = SecureRandom.hex(8)
    sh("security", "create-keychain", "-p", password, keychain, log: false)
    begin
      sh("security", "unlock-keychain", "-p", password, keychain, log: false)
      sh("security", "import", File.expand_path(options.fetch(:key)), "-k", keychain, "-T", "/usr/bin/codesign")
      sh("security", "import", cer, "-k", keychain)
      UI.important("macOS asks to allow exporting the key from the throwaway keychain: its password is #{password}")
      sh("security", "export", "-k", keychain, "-t", "identities", "-f", "pkcs12", "-P", "", "-o", p12)
    ensure
      sh("security", "delete-keychain", keychain, log: false)
      FileUtils.rm_rf(dir)
    end
  end
  # `fastlane match import` only takes the file paths interactively: call its importer directly
  require "match"
  params = FastlaneCore::Configuration.create(Match::Options.available_options, {
    type: "developer_id", platform: "macos", app_identifier: [MAC_ID], api_key: asc_key, readonly: false
  })
  params.load_configuration_file("Matchfile")
  Match::Importer.new.import_cert(params, cert_path: cer, p12_path: p12, profile_path: "")
end

desc "Refresh Developer ID profiles using the existing imported certificate (owner only)"
lane :mac_certificates do |options|
  UI.user_error!("mac_certificates writes match; run locally") if is_ci
  register_ids
  match(type: "developer_id", platform: "macos", app_identifier: MAC_ID, api_key: asc_key,
        readonly: false, force: options[:force].to_s == "true")
end

desc "Install the Developer ID identity and iCloud profile (CI: temporary keychain)"
lane :mac_signing do
  setup_ci if is_ci
  match(type: "developer_id", platform: "macos", app_identifier: MAC_ID, api_key: asc_key, readonly: true)
end

desc "iOS: one archive → App Store IPA (uploaded to TestFlight, not waiting for processing) + ad hoc IPA in dist/ios"
lane :ios_release do |options|
  sh("bash", File.expand_path("../apple/scripts/require-ios-sdk.sh", __dir__))
  setup_ci if is_ci
  key = asc_key
  match(type: "appstore", platform: "ios", app_identifier: IOS_IDS, api_key: key, readonly: true)
  match(type: "adhoc", platform: "ios", app_identifier: IOS_IDS, api_key: key, readonly: true)
  team = ENV["sigh_#{IOS_ID}_appstore_team-id"]
  appstore_profile = ENV["sigh_#{IOS_ID}_appstore_profile-name"]
  adhoc_profile = ENV["sigh_#{IOS_ID}_adhoc_profile-name"]
  share_appstore_profile = ENV["sigh_#{IOS_SHARE_ID}_appstore_profile-name"]
  share_adhoc_profile = ENV["sigh_#{IOS_SHARE_ID}_adhoc_profile-name"]
  out = File.expand_path("../dist/ios", __dir__)
  archive = File.join(out, "eSemnBun-iOS.xcarchive")
  # the project also has macOS targets: pin the platform or gym exports with the Mac installer method
  signing_args = ENV["ESEMNBUN_SIGNING_KEYCHAIN"].to_s.empty? ? "" : " OTHER_CODE_SIGN_FLAGS=\"--keychain #{ENV.fetch("ESEMNBUN_SIGNING_KEYCHAIN")}\""
  common = { project: PROJECT, scheme: "eSemnBun-iOS", configuration: "Release", destination: "generic/platform=iOS",
             sdk: "iphoneos", export_team_id: team, output_directory: out, archive_path: archive }
  pbxproj = File.join(PROJECT, "project.pbxproj")
  original = File.read(pbxproj)
  begin
    # Target-scoped signing: command-line overrides would also hit the SwiftPM package targets.
    update_code_signing_settings(path: PROJECT, use_automatic_signing: false, targets: ["eSemnBun-iOS"],
                                 build_configurations: ["Release"], team_id: team, profile_name: appstore_profile,
                                 code_sign_identity: "Apple Distribution")
    update_code_signing_settings(path: PROJECT, use_automatic_signing: false, targets: ["eSemnBunShare"],
                                 build_configurations: ["Release"], team_id: team, profile_name: share_appstore_profile,
                                 code_sign_identity: "Apple Distribution")
    version = get_version_number(xcodeproj: PROJECT, target: "eSemnBun-iOS", configuration: "Release")
    build_app(**common, export_method: "app-store", export_options: { provisioningProfiles: { IOS_ID => appstore_profile, IOS_SHARE_ID => share_appstore_profile } },
              output_name: "eSemnBun-#{version}-appstore.ipa", clean: true,
              xcargs: "CURRENT_PROJECT_VERSION=#{integer_build_number}#{signing_args}")
    # same archive, re-signed with the ad hoc profile: installs on the team's registered devices
    build_app(**common, skip_build_archive: true, export_method: "ad-hoc",
              export_options: { provisioningProfiles: { IOS_ID => adhoc_profile, IOS_SHARE_ID => share_adhoc_profile } },
              output_name: "eSemnBun-#{version}-adhoc.ipa")
  ensure
    File.write(pbxproj, original)   # never leave manual-signing edits in the committed project
  end
  upload = options.key?(:upload) ? options[:upload].to_s != "false" : is_ci
  if upload
    # returns as soon as App Store Connect has the binary; processing continues on Apple's side
    upload_to_testflight(api_key: key, ipa: File.join(out, "eSemnBun-#{version}-appstore.ipa"),
                         skip_waiting_for_build_processing: true, skip_submission: true)
  end
end

# Store and Developer ID signing remain separate: the Store requires a sandbox profile and installer identity.
desc "Create/update macOS App Store application and installer signing assets in match (owner only)"
lane :mac_store_certificates do |options|
  UI.user_error!("mac_store_certificates writes match; run locally") if is_ci
  register_ids
  match(type: "appstore", platform: "macos", app_identifier: MAC_ID, api_key: asc_key,
        readonly: false, force: options[:force].to_s == "true",
        additional_cert_types: ["mac_installer_distribution"])
end

desc "Archive sandboxed macOS App Store package; upload to TestFlight in CI"
lane :mac_store_release do |options|
  setup_ci if is_ci
  match(type: "appstore", platform: "macos", app_identifier: MAC_ID, api_key: asc_key,
        readonly: true, additional_cert_types: ["mac_installer_distribution"])
  profile = ENV.fetch("sigh_#{MAC_ID}_appstore_macos_profile-name")
  team = ENV.fetch("sigh_#{MAC_ID}_appstore_macos_team-id")
  out = File.expand_path("../dist/macos-app-store", __dir__)
  pbxproj = File.join(PROJECT, "project.pbxproj")
  original = File.read(pbxproj)
  begin
    update_code_signing_settings(path: PROJECT, use_automatic_signing: false,
      targets: ["eSemnBun-macOS"], build_configurations: ["AppStore Release"],
      team_id: team, profile_name: profile, code_sign_identity: "Apple Distribution")
    signing_args = ENV["ESEMNBUN_SIGNING_KEYCHAIN"].to_s.empty? ? "" : " OTHER_CODE_SIGN_FLAGS=\"--keychain #{ENV.fetch('ESEMNBUN_SIGNING_KEYCHAIN')}\""
    build_mac_app(project: PROJECT, scheme: "eSemnBun-macOS-AppStore", configuration: "AppStore Release",
      destination: "generic/platform=macOS", output_directory: out,
      archive_path: File.join(out, "eSemnBun.xcarchive"), output_name: "eSemnBun-AppStore",
      export_method: "app-store", export_team_id: team,
      export_options: { signingStyle: "manual", provisioningProfiles: { MAC_ID => profile },
        signingCertificate: "Apple Distribution", installerSigningCertificate: "3rd Party Mac Developer Installer" },
      xcargs: "CURRENT_PROJECT_VERSION=#{integer_build_number}#{signing_args}")
    sh(File.expand_path("../apple/scripts/verify-macos-distribution.sh", __dir__), "store",
       File.join(out, "eSemnBun.xcarchive", "Products", "Applications", "eSemnBun.app"))
    sh("pkgutil", "--check-signature", File.join(out, "eSemnBun-AppStore.pkg"))
    upload = options.key?(:upload) ? options[:upload].to_s != "false" : is_ci
    if upload
      upload_to_testflight(api_key: asc_key, pkg: File.join(out, "eSemnBun-AppStore.pkg"),
        app_identifier: MAC_ID, app_platform: "osx",
        skip_waiting_for_build_processing: true, skip_submission: true)
    end
  ensure
    File.write(pbxproj, original)
  end
end

desc "Upload an Android bundle to Google Play internal testing and stage closed testing"
lane :android_testing do
  build_number = integer_build_number
  bundle = Dir[File.expand_path('../dist/android/*.aab', __dir__)].reject { |p| p.include?('-unsigned') }
  UI.user_error!('Expected exactly one signed AAB') unless bundle.length == 1

  common = {
    package_name: 'md.esemnbun.app',
    json_key_data: ENV.fetch('GOOGLE_PLAY_SERVICE_ACCOUNT_JSON'),
    metadata_path: File.expand_path('../distribution/google/metadata/android', __dir__),
    skip_upload_metadata: ENV.fetch('PLAY_UPLOAD_METADATA', 'false') != 'true', skip_upload_images: true,
    skip_upload_screenshots: true, skip_upload_changelogs: true
  }

  # Internal is the immediate install path for the team. Until the Play app is published,
  # Google only permits draft releases on closed tracks; stage the same version code there
  # and retain the completed internal release. Once Play permits it, set
  # PLAY_CLOSED_RELEASE_STATUS=completed to make the closed release immediately available.
  upload_to_play_store(
    **common, aab: bundle.first, track: 'internal', release_status: 'completed'
  )
  upload_to_play_store(
    **common,
    track: 'internal', track_promote_to: ENV.fetch('PLAY_CLOSED_TRACK', 'alpha'),
    track_promote_release_status: ENV.fetch('PLAY_CLOSED_RELEASE_STATUS', 'draft'),
    version_code: build_number,
    skip_upload_apk: true, skip_upload_aab: true
  )
end


desc "Upload an Android bundle artifact without changing tracks or submitting for review"
lane :android_artifact do
  require 'supply'
  require 'digest'
  bundles = ENV['AAB_PATH'] ? [File.expand_path(ENV.fetch('AAB_PATH'))] : Dir[File.expand_path('../dist/android/*.aab', __dir__)].reject { |path| path.include?('-unsigned') }
  UI.user_error!('Expected exactly one signed AAB') unless bundles.length == 1
  Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, {
    package_name: 'md.esemnbun.app', json_key_data: ENV.fetch('GOOGLE_PLAY_SERVICE_ACCOUNT_JSON'),
    changes_not_sent_for_review: true, rescue_changes_not_sent_for_review: false
  })
  client = Supply::Client.make_from_config
  client.begin_edit(package_name: 'md.esemnbun.app')
  begin
    tracks_before = client.tracks.map(&:to_h)
    uploaded = Array(client.client.list_edit_bundles(client.current_package_name, client.current_edit.id).bundles)
    existing = uploaded.find { |bundle| bundle.sha256.to_s.downcase == Digest::SHA256.file(bundles.first).hexdigest }
    if existing
      client.abort_current_edit
      UI.success("Bundle artifact #{existing.version_code} already uploaded; tracks unchanged")
    else
      code = client.upload_bundle(bundles.first)
      UI.user_error!('Track state changed during artifact upload') unless client.tracks.map(&:to_h) == tracks_before
      begin
        client.client.commit_edit(client.current_package_name, client.current_edit.id,
                                  changes_not_sent_for_review: true, changes_in_review_behavior: 'ERROR_IF_IN_REVIEW')
      rescue Google::Apis::ClientError => error
        # Some apps reject this parameter. Never use Google's default, which cancels an active review.
        raise unless error.message.include?('The query parameter changesNotSentForReview must not be set')
        client.client.commit_edit(client.current_package_name, client.current_edit.id,
                                  changes_in_review_behavior: 'ERROR_IF_IN_REVIEW')
      end
      client.current_edit = nil
      client.current_package_name = nil
      UI.success("Uploaded bundle artifact #{code}; tracks unchanged")
    end
  rescue
    client.abort_current_edit if client.current_edit
    raise
  end
end
