# macOS
.DS_Store

# SwiftPM / Xcode
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# Android / Gradle (see also android/.gitignore)
.gradle/
local.properties
*.iml
.idea/

# .NET (see also windows/.gitignore)
bin/
obj/
.vs/
*.user

# secrets that must never land in git
*.pin
.env

# packaging outputs and portable-mode test builds
dist/
.build-portable/

# Ruby gems installed by `bundle install` (fastlane)
vendor/bundle/
.bundle/

# fastlane run output (README.md is regenerated by fastlane on every run; notes live in SIGNING.md)
fastlane/report.xml
fastlane/README.md
fastlane/Preview.html

# Developer-specific VM/device inventory and local evidence (no credentials)
.local/

# Generated signed package feeds (fetched at deployment).
/website/static/packages/
