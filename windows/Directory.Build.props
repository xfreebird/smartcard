<Project>
  <!-- Shared settings for every project under windows/. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Public product name eSemnBun (file properties, Task Manager); the codename MoldSign stays in namespaces/IDs. -->
    <Company>eSemnBun</Company>
    <Product>eSemnBun</Product>
    <!-- One version for app, CLI and installers (the eSemnBun rebrand ships as 0.2.2 on every platform).
         scripts/package-windows.ps1 reads it from here; MSIX uses <Version>.0. -->
    <Version>0.2.2</Version>
    <Deterministic>true</Deterministic>
    <!-- Repo root (windows/..): spec/ lives there and is shared with the Swift and Kotlin ports. -->
    <MoldSignRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</MoldSignRepoRoot>
  </PropertyGroup>
</Project>
