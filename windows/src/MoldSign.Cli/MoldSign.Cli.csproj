<Project Sdk="Microsoft.NET.Sdk">

  <!--
    moldsign.exe: the Windows CLI (spec/cli.md, CLI-03). Product RIDs: win-x64, win-arm64.
    Plain net10.0 so it also builds/tests on other hosts; there, card commands exit 5 with
    "PC/SC transport is only available on Windows" (macOS/Linux ship the native Swift CLI, CLI-02).
    NativeAOT: dotnet publish -c Release -r win-x64 -p:PublishAot=true   (must run on Windows)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>moldsign</AssemblyName>
    <RootNamespace>MoldSign.Cli</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MoldSign.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MoldSign.Core/MoldSign.Core.csproj" />
  </ItemGroup>

</Project>
