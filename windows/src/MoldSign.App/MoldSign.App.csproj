<Project Sdk="Microsoft.NET.Sdk">

  <!--
    eSemnBun tray app (codename MoldSign): WinUI 3 (Windows App SDK), self-contained Windows App SDK runtime.
    Builds on Windows only (the XAML compiler and MakePri are Windows tools):
      dotnet build src/MoldSign.App -c Debug -p:Platform=x64

    One project, two distributions (WIN-08, WIN-09; scripts/package-windows.ps1 builds both):
      * unpackaged (default, WindowsPackageType=None): what `dotnet run`, the MSI (installer/) and a portable
        folder use. Start at sign-in = Run key; settings in %LOCALAPPDATA%\MoldSign.
      * single-project MSIX: -p:WindowsPackageType=MSIX -p:GenerateAppxPackageOnBuild=true, with
        Package.appxmanifest (identity placeholders replaced by the script). Start at sign-in = StartupTask.
    Signing is never configured here: the script signs with signtool from environment variables only.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>MoldSign.App</RootNamespace>
    <!-- Public name eSemnBun (docs/10 §0.2b): eSemnBun.exe. Namespaces/IDs keep the codename MoldSign. -->
    <AssemblyName>eSemnBun</AssemblyName>
    <AssemblyTitle>eSemnBun</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>ro-RO</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- MSIX packaging defaults (used only when WindowsPackageType=MSIX). -->
  <PropertyGroup>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Assets/** is already Content (WinUI EnableDefaultAssets): tray status icons, AppIcon.ico, MSIX logos, all
      generated by scripts/make-icons.py. Copy them next to the exe for the unpackaged app (TrayIconService loads
      Assets\Tray\*.ico from the app folder); the MSIX packs them from the same items.
    -->
    <Content Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendor localhost.cts.md TLS identity for the browser bridge (D-03): shipped in the MSI and MSIX. -->
    <Content Include="..\..\..\swift\MoldSignKit\Resources\localhost.p12" Link="localhost.p12"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel for the browser bridge (BridgeHost, WIN-06). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MoldSign.Core/MoldSign.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

</Project>
