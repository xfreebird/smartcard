<?xml version="1.0" encoding="utf-8"?>
<!-- StatusCard (docs/10 §3): card art + holder + status line + validity. States come from AppState.Kind. -->
<UserControl
    x:Class="MoldSign.App.Controls.StatusCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource MsCardBorderStyle}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card art: yellow chip on a blue card (decorative). -->
            <Border
                Width="48"
                Height="32"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Background="{ThemeResource BrandBrush}"
                CornerRadius="5">
                <Border
                    Width="11"
                    Height="9"
                    Margin="7,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentChipBrush}"
                    CornerRadius="2" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Style="{StaticResource MsHeadlineTextStyle}" Text="{x:Bind State.Holder, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{x:Bind State.DotBrush, Mode=OneWay}" />
                    <ProgressRing
                        Width="12"
                        Height="12"
                        IsActive="{x:Bind State.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind State.IsBusy, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind State.StatusLine, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="{x:Bind State.ValidityLine, Mode=OneWay}"
                    Visibility="{x:Bind State.ValidityVisibility, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
