<?xml version="1.0" encoding="utf-8"?>
<!--
  Status light in the app (docs/10 §0.1, UX-01): the same dot as the tray icon plus the same text. The dot is never
  the only signal: the label is always visible (Narrator reads it) and is the tooltip too. Idle = no dot.
-->
<UserControl
    x:Class="MoldSign.App.Controls.StatusLightPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="6"
        ToolTipService.ToolTip="{x:Bind State.LightLabel, Mode=OneWay}">
        <Ellipse
            Width="8"
            Height="8"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            Fill="{x:Bind State.LightBrush, Mode=OneWay}"
            Visibility="{x:Bind State.LightDotVisibility, Mode=OneWay}" />
        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource MsCaptionTextStyle}"
            Text="{x:Bind State.LightLabel, Mode=OneWay}" />
    </StackPanel>
</UserControl>
