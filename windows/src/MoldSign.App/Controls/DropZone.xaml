<?xml version="1.0" encoding="utf-8"?>
<!--
  DropZone (docs/10 §3): dashed active border, radius 14; drag-over = brandSoft fill + brand border.
  Large (default, ~170 epx): icon, "Trage documentele aici", the "Alege fișiere…" button, the format hint.
  Compact (IsCompact, under the document list once files were added): one row with the same button.
-->
<UserControl
    x:Class="MoldSign.App.Controls.DropZone"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="170"
    AllowDrop="True"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <Grid Background="Transparent">
        <Rectangle
            x:Name="Outline"
            Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
            RadiusX="14"
            RadiusY="14"
            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            StrokeThickness="1"
            StrokeDashArray="5,4" />

        <StackPanel
            x:Name="LargeContent"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource BrandBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                x:Uid="DropTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource MsHeadlineTextStyle}"
                Text="Trage documentele aici" />
            <Button
                x:Uid="DropBrowse" AutomationProperties.AutomationId="ChooseDocuments"
                HorizontalAlignment="Center"
                Click="OnBrowseClick"
                Content="Alege fișiere…" />
            <TextBlock
                x:Name="HintText"
                x:Uid="DropHint"
                HorizontalAlignment="Center"
                Style="{StaticResource MsCaptionTextStyle}"
                Text="PDF → semnătură PDF · altele → semnătură XML" />
        </StackPanel>

        <Grid
            x:Name="CompactContent"
            Padding="16,8"
            ColumnSpacing="12"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{ThemeResource BrandBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                x:Uid="DropTitleCompact"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource MsCaptionTextStyle}"
                Text="Trage aici alte documente" />
            <Button
                x:Uid="DropBrowseCompact" AutomationProperties.AutomationId="ChooseMoreDocuments"
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="OnBrowseClick"
                Content="Alege fișiere…" />
        </Grid>
        <InfoBar
            x:Name="Failure"
            MaxWidth="520"
            VerticalAlignment="Bottom"
            IsOpen="False"
            Severity="Error" />
    </Grid>
</UserControl>
