<?xml version="1.0" encoding="utf-8"?>
<!-- DropZone (docs/10 §3): dashed 1.5 border, radius 14; drag-over = brandSoft fill + solid brand border. -->
<UserControl
    x:Class="MoldSign.App.Controls.DropZone"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <Grid MinHeight="128" Background="Transparent">
        <Rectangle
            x:Name="Outline"
            Fill="Transparent"
            RadiusX="14"
            RadiusY="14"
            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            StrokeDashArray="4,3"
            StrokeThickness="1.5" />
        <StackPanel
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="4">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="22"
                Foreground="{ThemeResource BrandBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                x:Uid="DropTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource MsHeadlineTextStyle}"
                Text="Trage documentele aici" />
            <HyperlinkButton
                x:Uid="DropBrowse"
                Padding="4,2"
                HorizontalAlignment="Center"
                Click="OnBrowseClick"
                Content="sau alege fișiere" />
            <TextBlock
                x:Name="HintText"
                x:Uid="DropHint"
                HorizontalAlignment="Center"
                Style="{StaticResource MsCaptionTextStyle}"
                Text="PDF → PAdES · altele → XAdES" />
        </StackPanel>
    </Grid>
</UserControl>
