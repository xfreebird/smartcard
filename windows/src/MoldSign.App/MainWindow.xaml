<?xml version="1.0" encoding="utf-8"?>
<!--
  Main window (docs/10 §4.2, §0.3 Windows row; UX-06, WIN-04): Mica backdrop, NavigationView (Semnează / Verifică /
  Activitate / Card + settings gear), status light in the title bar, and an InfoBar for status and errors
  ("Niciun cititor conectat", "Cardul nu răspunde · Scoate și reintrodu cardul" + Recitește cardul).
  The title bar keeps the system caption buttons, so Snap layouts work.
-->
<Window
    x:Class="MoldSign.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoldSign.App.Controls"
    Title="eSemnBun">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,140,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Image
                    Width="16"
                    Height="16"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="eSemnBun" />
            </StackPanel>
            <controls:StatusLightPill Grid.Column="1" />
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Uid="NavSign"
                    Content="Semnează"
                    Tag="sign">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavVerify"
                    Content="Verifică"
                    Tag="verify">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavActivity"
                    Content="Activitate"
                    Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavCard"
                    Content="Card"
                    Tag="card">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar Grid.Row="0" Margin="32,12,32,0" IsClosable="False"
                    AutomationProperties.AutomationId="DemoModeBanner"
                    IsOpen="{x:Bind State.IsDemo, Mode=OneWay}"
                    Message="{x:Bind State.DemoDisclaimer, Mode=OneWay}" Severity="Informational" />
                <!-- Status / errors (docs/10 §0.3: InfoBar), driven by the status light. -->
                <InfoBar Grid.Row="1"
                    Margin="32,16,32,0"
                    IsClosable="True"
                    IsOpen="{x:Bind State.StatusInfoOpen, Mode=OneWay}"
                    Message="{x:Bind State.StatusInfoMessage, Mode=OneWay}"
                    Severity="{x:Bind State.StatusInfoSeverity, Mode=OneWay}"
                    Title="{x:Bind State.StatusInfoTitle, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="StatusInfoReread"
                            Click="OnStatusRereadClick"
                            Content="Recitește cardul"
                            Visibility="{x:Bind State.StatusInfoActionVisibility, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
