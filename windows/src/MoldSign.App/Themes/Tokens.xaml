<?xml version="1.0" encoding="utf-8"?>
<!-- Design tokens (docs/10-design-system.md §2). Windows: system accent for selection, brand for the primary button. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BrandColor">#2350D8</Color>
            <SolidColorBrush x:Key="BrandBrush" Color="#2350D8" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#E8EEFF" />
            <SolidColorBrush x:Key="AccentChipBrush" Color="#F5B700" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EDF7F0" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF5E7" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />

            <!-- Lightweight styling: every AccentButtonStyle button is the brand primary button. -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#2350D8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2F5CE3" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1C42B5" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E8EEFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="BrandColor">#7C9BFF</Color>
            <SolidColorBrush x:Key="BrandBrush" Color="#7C9BFF" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#1C2547" />
            <SolidColorBrush x:Key="AccentChipBrush" Color="#FFCD3C" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#12291B" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#2E2410" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#331616" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1E1F24" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#7C9BFF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#91ABFF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#6A8BF0" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B1020" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B1020" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B1020" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentChipBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Radius: control 8 (Win), card 14, sheet 18. Spacing scale 4, 8, 12, 16, 20, 24, 32. -->
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="SheetCornerRadius">18</CornerRadius>
    <Thickness x:Key="PagePadding">32,24,32,24</Thickness>

    <!-- Type: Segoe UI Variable; title 22 semibold, headline 15 semibold, body 14, caption 12. -->
    <Style x:Key="MsTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="MsHeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="MsCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="MsSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Icon-only toolbar button (re-read, settings): transparent until hovered; always has a Narrator name + tooltip. -->
    <Style x:Key="MsIconButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Full-width menu-item row in the tray flyout (open window, quit): transparent until hovered. -->
    <Style x:Key="MsMenuRowButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Raised card surface (details panels, SignatureCard…). -->
    <Style x:Key="MsCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
</ResourceDictionary>
