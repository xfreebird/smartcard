<?xml version="1.0" encoding="utf-8"?>
<!-- Tray flyout (docs/10 §4.6): mirrors the macOS popover (§4.1) with Fluent styling and an acrylic backdrop. -->
<Window
    x:Class="MoldSign.App.Tray.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoldSign.App.Controls"
    xmlns:services="using:MoldSign.App.Services"
    Title="MoldSign">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource MsHeadlineTextStyle}"
                Text="MoldSign" />
            <Button
                x:Uid="FlyoutSettings"
                Padding="6"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Setări"
                Background="Transparent"
                BorderThickness="0"
                Click="OnSettingsClick">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <controls:StatusCard Grid.Row="1" />

        <controls:DropZone x:Name="Drop" Grid.Row="2" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="FlyoutSign"
                HorizontalAlignment="Stretch"
                Click="OnSignClick"
                Content="Semnează…"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Uid="FlyoutVerify"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="OnVerifyClick"
                Content="Verifică…" />
        </Grid>

        <InfoBar
            x:Name="Result"
            Grid.Row="4"
            IsClosable="True"
            IsOpen="False" />

        <TextBlock
            x:Uid="RecentHeader"
            Grid.Row="5"
            Style="{StaticResource MsSectionHeaderTextStyle}"
            Text="RECENTE" />

        <Grid Grid.Row="6">
            <ListView
                IsItemClickEnabled="True"
                ItemClick="OnRecentClick"
                ItemsSource="{x:Bind State.Recent}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ActivityItem">
                        <Grid Padding="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind FileName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource MsCaptionTextStyle}"
                                Text="{x:Bind WhenText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Uid="RecentEmpty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource MsCaptionTextStyle}"
                Text="Nicio activitate încă"
                Visibility="{x:Bind State.RecentEmptyVisibility, Mode=OneWay}" />
        </Grid>

        <!-- Browser bridge -->
        <Grid
            Grid.Row="7"
            Padding="0,8,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon VerticalAlignment="Center" Glyph="&#xE774;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Uid="BridgeLabel" Text="Conexiune browser" />
                <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind State.BridgeStatus, Mode=OneWay}" />
            </StackPanel>
            <ToggleSwitch
                x:Name="BridgeToggle"
                x:Uid="BridgeToggle"
                Grid.Column="2"
                MinWidth="0"
                AutomationProperties.Name="Conexiune browser"
                IsOn="{x:Bind State.BridgeEnabled, Mode=OneWay}"
                OffContent=""
                OnContent=""
                Toggled="OnBridgeToggled" />
        </Grid>

        <Grid Grid.Row="8">
            <HyperlinkButton
                x:Uid="TrayOpenWindow"
                Click="OnOpenWindowClick"
                Content="Deschide fereastra" />
            <HyperlinkButton
                x:Uid="TrayQuit"
                HorizontalAlignment="Right"
                Click="OnQuitClick"
                Content="Ieșire" />
        </Grid>
    </Grid>
</Window>
