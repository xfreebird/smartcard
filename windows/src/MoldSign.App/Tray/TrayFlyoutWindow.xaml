<?xml version="1.0" encoding="utf-8"?>
<!--
  Tray flyout (docs/10 §4.6, §0.2): mirrors the macOS popover (§4.1) with Fluent styling and an acrylic backdrop.
  The card wallet sits on top (the selector itself), the status light text under the title, then the accent Sign
  button, recent activity (what, not when), the browser connection and the window/quit rows. No drop zone: the
  flyout hides as soon as Explorer gets focus, so a drag can never reach it.
-->
<Window
    x:Class="MoldSign.App.Tray.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoldSign.App.Controls"
    xmlns:services="using:MoldSign.App.Services"
    Title="eSemnBun">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Padding="16,12,16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + status light text, re-read and settings -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource MsHeadlineTextStyle}" Text="eSemnBun" />
                <controls:StatusLightPill />
                <TextBlock Text="{x:Bind State.DemoDisclaimer, Mode=OneWay}" MaxWidth="260" TextWrapping="Wrap"
                    Style="{StaticResource MsCaptionTextStyle}" Visibility="{x:Bind State.DemoVisibility, Mode=OneWay}" />
            </StackPanel>
            <Button
                x:Uid="FlyoutReread"
                Grid.Column="1"
                AutomationProperties.Name="Recitește cardul"
                Click="OnRereadClick"
                Style="{StaticResource MsIconButtonStyle}"
                ToolTipService.ToolTip="Recitește cardul">
                <FontIcon FontSize="16" Glyph="&#xE72C;" />
            </Button>
            <Button
                x:Uid="FlyoutSettings"
                Grid.Column="2"
                AutomationProperties.Name="Setări"
                Click="OnSettingsClick"
                Style="{StaticResource MsIconButtonStyle}"
                ToolTipService.ToolTip="Setări">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!-- Card wallet: the inserted cards are the selector (docs/10 §0.2) -->
        <controls:CardWallet x:Name="Wallet" Grid.Row="1" IsCompact="True" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Style + IsEnabled from code: accent only while enabled (never a disabled accent-filled button). -->
            <Button
                x:Name="SignButton"
                x:Uid="FlyoutSign"
                HorizontalAlignment="Stretch"
                Click="OnSignClick"
                Content="Semnează…" />
            <Button
                x:Uid="FlyoutVerify"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="OnVerifyClick"
                Content="Verifică…" />
        </Grid>

        <InfoBar
            x:Name="Result"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False" />

        <!-- Recent documents (existing files only) + "Golește lista" (no confirmation, like "Clear recent"). -->
        <Grid Grid.Row="4">
            <TextBlock
                x:Uid="RecentHeader"
                VerticalAlignment="Center"
                Style="{StaticResource MsSectionHeaderTextStyle}"
                Text="RECENTE" />
            <HyperlinkButton
                x:Uid="RecentClear"
                Padding="4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnClearRecentClick"
                Content="Golește lista"
                FontSize="12"
                Visibility="{x:Bind State.RecentClearVisibility, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="5" MinHeight="40" MaxHeight="160">
            <ListView
                x:Uid="RecentList"
                AutomationProperties.Name="Recente"
                IsItemClickEnabled="True"
                ItemClick="OnRecentClick"
                ItemsSource="{x:Bind State.RecentDocuments}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ActivityItem">
                        <Grid Padding="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind FileName}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Uid="RecentDocsEmpty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource MsCaptionTextStyle}"
                Text="Niciun document recent"
                Visibility="{x:Bind State.RecentEmptyVisibility, Mode=OneWay}" />
        </Grid>

        <!-- Browser bridge -->
        <Grid
            Grid.Row="6"
            Padding="0,8,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon VerticalAlignment="Center" Glyph="&#xE774;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Uid="BridgeLabel" Text="Conexiune browser" />
                <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind State.BridgeStatus, Mode=OneWay}" />
            </StackPanel>
            <ToggleSwitch
                x:Name="BridgeToggle"
                x:Uid="BridgeToggle"
                Grid.Column="2"
                MinWidth="0"
                AutomationProperties.Name="Conexiune browser"
                IsOn="{x:Bind State.BridgeEnabled, Mode=OneWay}"
                OffContent=""
                OnContent=""
                Toggled="OnBridgeToggled" />
        </Grid>

        <!-- Window / quit: one row each, menu-item style -->
        <StackPanel
            Grid.Row="7"
            Padding="0,6,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Button
                x:Uid="TrayOpenWindow"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnOpenWindowClick"
                Content="Deschide eSemnBun"
                Style="{StaticResource MsMenuRowButtonStyle}" />
            <Button
                x:Uid="TrayQuit"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnQuitClick"
                Content="Ieșire"
                Style="{StaticResource MsMenuRowButtonStyle}" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
