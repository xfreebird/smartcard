<?xml version="1.0" encoding="utf-8"?>
<!-- Verifică (docs/10 §4.2): DropZone → VerdictBadge + SignatureCards. -->
<Page
    x:Class="MoldSign.App.Views.VerifyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoldSign.App.Controls"
    xmlns:views="using:MoldSign.App.Views">

    <Page.Resources>
        <Style x:Key="DisclosureIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource BrandSoftBrush}" />
        </Style>
        <Style x:Key="DisclosureIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource BrandBrush}" />
        </Style>
        <Style x:Key="DisclosureLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="VerificationCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="VerifySuccessIconStyle" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource SuccessBrush}" /></Style>
        <Style x:Key="VerifyDangerIconStyle" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource DangerBrush}" /></Style>
        <Style x:Key="VerifyWarningIconStyle" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource WarningBrush}" /></Style>
        <Style x:Key="VerifySecondaryIconStyle" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /></Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock
                x:Name="PageTitle" x:Uid="VerifyPageTitle" AutomationProperties.AutomationId="VerifyPageTitle"
                Style="{StaticResource MsTitleTextStyle}"
                Text="Verifică" />

            <controls:DropZone x:Name="FileDrop" />

            <Button x:Name="ClearResults" AutomationProperties.AutomationId="VerifyClearResults" x:Uid="VerifyClearResults" Click="OnClearResultsClick" Content="Clear results" Visibility="Collapsed" />

            <StackPanel x:Name="DocumentInfo" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="DocumentName" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <views:DocumentFileActions x:Name="FileActions" ShowFolderLabel="True" />
            </StackPanel>

            <StackPanel x:Name="Checking" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                <ProgressRing x:Name="Spinner" Width="24" Height="24" IsActive="False" />
                <TextBlock x:Uid="VerifyChecking" VerticalAlignment="Center" Text="Se verifică…" />
            </StackPanel>

            <!-- VerdictBadge -->
            <Grid
                x:Name="Verdict"
                ColumnSpacing="12"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="VerdictIcon"
                    FontSize="32"
                    Glyph="&#xE73E;" />
                <TextBlock
                    x:Name="VerdictText" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="VerificationOutcome"
                    VerticalAlignment="Center"
                    Style="{StaticResource MsTitleTextStyle}" />
            </Grid>

            <TextBlock x:Name="SignatureCount" Visibility="Collapsed" />
            <StackPanel x:Name="SignatureCards" Spacing="16" />

            <StackPanel x:Name="ReferencedDocuments" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="VerifyDetachedHint" TextWrapping="Wrap"
                    Text="Pentru o semnătură detașată, adaugă documentele originale pentru verificarea integrității." />
                <Button x:Uid="VerifyAddDocuments" Click="OnAddDocumentsClick" Content="Alege documentele semnate…" />
                <TextBlock x:Name="ReferencedNames" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                x:Name="Result"
                IsClosable="True"
                IsOpen="False" />

            <TextBlock
                x:Name="FormatHint" x:Uid="VerifyHint"
                Style="{StaticResource MsCaptionTextStyle}"
                Text="PDF semnat (semnătură PDF) sau semnătură .xml (semnătură XML); pentru o semnătură detașată alege și fișierele semnate."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
