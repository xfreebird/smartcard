<UserControl
    x:Class="MoldSign.App.Views.DocumentFileActions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="OpenFile" AutomationProperties.AutomationId="OpenDocumentFile" Click="OnOpen" Padding="10,5">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                <TextBlock x:Name="OpenLabel" />
            </StackPanel>
        </Button>
        <Button x:Name="RevealFile" AutomationProperties.AutomationId="RevealDocumentFile"
                Click="OnReveal" Padding="8,5" Style="{StaticResource SubtleButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                <TextBlock x:Name="RevealLabel" Visibility="Collapsed" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
