<?xml version="1.0" encoding="utf-8"?>
<!--
  Card (docs/10 §4.2 + §0.2): the large card wallet (pick the card that signs), the selected card's certificate
  details, "Recitește cardul" in the toolbar, remember-PIN toggles and troubleshooting.
-->
<Page
    x:Class="MoldSign.App.Views.CardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoldSign.App.Controls">

    <ScrollViewer x:Name="CardScroll"
                  AutomationProperties.AutomationId="CardScroll"
                  IsTabStop="True"
                  VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="CardPageTitle"
                        Style="{StaticResource MsTitleTextStyle}"
                        Text="Card" />
                    <controls:StatusLightPill />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Click="OnRereadClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Uid="CardRereadLabel" Text="Recitește cardul" />
                    </StackPanel>
                </Button>
            </Grid>

            <controls:CardWallet IsCompact="False" />

            <Border Style="{StaticResource MsCardBorderStyle}">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="CardHolder" Style="{StaticResource MsCaptionTextStyle}" Text="Titular" />
                    <TextBlock x:Name="HolderText" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Uid="CardIssuer" Grid.Row="1" Style="{StaticResource MsCaptionTextStyle}" Text="Emitent" />
                    <TextBlock x:Name="IssuerText" Grid.Row="1" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Uid="CardValidity" Grid.Row="2" Style="{StaticResource MsCaptionTextStyle}" Text="Valabil" />
                    <TextBlock x:Name="ValidityText" Grid.Row="2" Grid.Column="1" />
                    <TextBlock x:Uid="CardSerial" Grid.Row="3" Style="{StaticResource MsCaptionTextStyle}" Text="Număr de serie" />
                    <TextBlock x:Name="SerialText" Grid.Row="3" Grid.Column="1" IsTextSelectionEnabled="True" />
                    <TextBlock x:Uid="CardSha1" Grid.Row="4" Style="{StaticResource MsCaptionTextStyle}" Text="SHA-1" />
                    <TextBlock x:Name="Sha1Text" Grid.Row="4" Grid.Column="1" IsTextSelectionEnabled="True" />
                    <TextBlock x:Uid="CardReader" Grid.Row="5" Style="{StaticResource MsCaptionTextStyle}" Text="Cititor" />
                    <TextBlock x:Name="ReaderText" Grid.Row="5" Grid.Column="1" IsTextSelectionEnabled="True" />
                </Grid>
            </Border>

            <ToggleSwitch
                x:Name="RememberToggle"
                x:Uid="CardRememberPin"
                Header="Ține minte PIN-ul (Windows Hello)"
                Toggled="OnRememberToggled" />
            <Button
                x:Name="ForgetPinButton"
                AutomationProperties.AutomationId="CardForgetPin"
                x:Uid="CardForgetPin"
                Click="OnForgetClick"
                Content="Șterge PIN-ul salvat" />

            <InfoBar
                x:Name="Result"
                IsClosable="True"
                IsOpen="False" />

            <TextBlock
                x:Uid="CardTipsHeader"
                Style="{StaticResource MsSectionHeaderTextStyle}"
                Text="DACĂ CARDUL NU RĂSPUNDE" />
            <TextBlock
                AutomationProperties.AutomationId="CardTips"
                x:Uid="CardTips"
                Style="{StaticResource MsCaptionTextStyle}"
                Text="Scoate cardul și reintrodu-l. Conectează cititorul direct la computer, fără hub. PIN-ul nu se încearcă niciodată automat după o greșeală."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
