<?xml version="1.0" encoding="utf-8"?>
<!-- Semnează (docs/10 §4.2): DropZone → FileRows with auto FormatChips → Opțiuni avansate → StatusCard + primary button. -->
<Page
    x:Class="MoldSign.App.Views.SignPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoldSign.App.Controls"
    xmlns:views="using:MoldSign.App.Views">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="SignPageTitle"
            Style="{StaticResource MsTitleTextStyle}"
            Text="Semnează" />

        <controls:DropZone x:Name="Drop" Grid.Row="1" />

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind Files}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:FileRow">
                    <Grid Padding="0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8A5;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Path}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MsCaptionTextStyle}"
                            Text="{x:Bind SizeText}" />
                        <Border
                            Grid.Column="3"
                            Padding="10,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource BrandSoftBrush}"
                            CornerRadius="10">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource BrandBrush}"
                                Text="{x:Bind Format}" />
                        </Border>
                        <Button
                            x:Uid="FileRemove"
                            Grid.Column="4"
                            Padding="6"
                            AutomationProperties.Name="Elimină"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRemoveClick"
                            Tag="{x:Bind Path}">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Expander
            x:Uid="SignAdvanced"
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="Opțiuni avansate">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Uid="SignPdfFormat"
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="PDF → PAdES-T (cerut de msign.gov.md)" />
                <ComboBox
                    x:Name="XadesFormatBox"
                    x:Uid="SignXadesFormat"
                    Header="Alte fișiere"
                    SelectedIndex="1">
                    <ComboBoxItem Content="XAdES-BES" />
                    <ComboBoxItem Content="XAdES-T" />
                    <ComboBoxItem Content="XAdES-C" />
                </ComboBox>
                <RadioButtons
                    x:Name="PackagingButtons"
                    x:Uid="SignPackaging"
                    Header="Tip"
                    SelectedIndex="0">
                    <x:String>Detașat</x:String>
                    <x:String>Încorporat</x:String>
                </RadioButtons>
                <TextBlock
                    x:Uid="SignAlgorithm"
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="Algoritm: SHA-256" />
                <!-- TODO(WIN-01): output policy "Lângă original" / "Alege dosar…" once signing is ported. -->
            </StackPanel>
        </Expander>

        <InfoBar
            x:Name="Result"
            Grid.Row="4"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="5" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:StatusCard />
            <Button
                x:Name="SignButton"
                Grid.Column="1"
                MinWidth="180"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnSignClick"
                Content="Semnează"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Page>
