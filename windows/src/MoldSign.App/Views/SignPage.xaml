<?xml version="1.0" encoding="utf-8"?>
<!--
  Semnează (docs/10 §4.2 + §0.2b): the documents area (a large dashed drop zone with "Alege fișiere…"; once files are
  added, their list with a format picker per row and the drop zone, compact, under it) below who signs (the centered
  card carousel), Opțiuni avansate, then the progress line and the primary
  button "Semnează N documente" (Ctrl+Enter). The button is accent-filled only while it is enabled.
-->
<Page
    x:Class="MoldSign.App.Views.SignPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoldSign.App.Controls"
    xmlns:views="using:MoldSign.App.Views">

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="SignPageTitle" AutomationProperties.AutomationId="SignPageTitle"
            Style="{StaticResource MsTitleTextStyle}"
            Text="Semnează" />

            <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" Padding="0,8" Spacing="20">
            <StackPanel x:Name="SignedResults" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="SignedResultsTitle" Style="{StaticResource MsSectionHeaderTextStyle}" />
                <StackPanel x:Name="SignedFiles" Spacing="4" />
            </StackPanel>
                <controls:CardWallet HorizontalAlignment="Stretch" IsCompact="True" />

            <!-- Documents follow the selected card, in one vertical reading order. -->
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ListRow" Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="FileList"
                    MaxHeight="240"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    x:Uid="SignFileList"
                    AutomationProperties.Name="Documente de semnat"
                    ItemsSource="{x:Bind Files}"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:FileRow">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,4"><Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Spacing="8"
                                    Visibility="{x:Bind ErrorVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource DangerBrush}" />
                                </StackPanel>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE8A5;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Path}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MsCaptionTextStyle}"
                                    Text="{x:Bind SizeText}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                                    <Border CornerRadius="6" Padding="6,3" Background="{ThemeResource BrandSoftBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE8A5;" FontSize="11" Foreground="{ThemeResource BrandBrush}" /><TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource BrandBrush}" /></StackPanel>
                                    </Border>
                                    <Border CornerRadius="6" Padding="6,3" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" Visibility="{x:Bind StampVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE70F;" FontSize="11" /><TextBlock Text="{x:Bind StampSummary, Mode=OneWay}" FontSize="11" /></StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="OnFileOptionsClick" Tag="{x:Bind Path}" AutomationProperties.Name="{x:Bind OptionsLabel}">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    </Button>
                                </StackPanel>

                            </Grid></Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <controls:DropZone
                    x:Name="DocumentDrop"
                    MinHeight="156"
                    Grid.Row="1"
                    VerticalAlignment="Top" />
            </Grid>



            </StackPanel>

        <Expander
            x:Uid="SignAdvanced"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="Opțiuni avansate">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Uid="SignPdfFormat"
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="PDF → semnătură PDF (cerut de msign.gov.md); semnătură XML produce un fișier .xml separat"
                    TextWrapping="Wrap" />
                <RadioButtons
                    x:Name="PackagingButtons"
                    x:Uid="SignPackaging"
                    Header="semnătură XML"
                    SelectedIndex="0">
                    <RadioButton x:Name="DetachedOption" />
                    <RadioButton x:Name="EnvelopingOption" />
                </RadioButtons>
                <TextBlock
                    x:Uid="SignAlgorithm"
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="Algoritm: SHA-256" />
                <!-- TODO(WIN-01): output policy "Lângă original" / "Alege dosar…" once signing is ported. -->
            </StackPanel>
        </Expander>

        <InfoBar
            x:Name="Result" AutomationProperties.AutomationId="SigningOutcome"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False" />

    </Grid>
    </ScrollViewer>

        <!-- Keep the signing action reachable while documents and options scroll. -->
        <Grid x:Name="SigningFooter" Grid.Row="1" Padding="32,16" ColumnSpacing="16" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind State.ProgressVisibility, Mode=OneWay}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind State.IsBusy, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="{x:Bind State.ProgressText, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
            <controls:StatusLightPill Visibility="{x:Bind State.NotBusyVisibility, Mode=OneWay}" />
            <!-- Style set from code: accent only while enabled (a disabled accent button reads as broken). -->
            <Button
                x:Name="SignButton" AutomationProperties.AutomationId="SignDocuments"
                Grid.Column="1"
                MinWidth="180"
                Click="OnSignClick"
                Content="Semnează"
                IsEnabled="False">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Page>
