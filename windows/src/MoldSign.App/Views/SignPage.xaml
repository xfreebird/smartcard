<?xml version="1.0" encoding="utf-8"?>
<!--
  Semnează (docs/10 §4.2 + §0.2b): the documents area (a large dashed drop zone with "Alege fișiere…"; once files are
  added, their list with a format picker per row and the drop zone, compact, under it) below who signs (the centered
  card carousel), Opțiuni avansate, then the progress line and the primary
  button "Semnează N documente" (Ctrl+Enter). The button is accent-filled only while it is enabled.
-->
<Page
    x:Class="MoldSign.App.Views.SignPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoldSign.App.Controls"
    xmlns:views="using:MoldSign.App.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="SignPageTitle" AutomationProperties.AutomationId="SignPageTitle"
            Style="{StaticResource MsTitleTextStyle}"
            Text="Semnează" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" Padding="8" Spacing="20">
                <controls:CardWallet HorizontalAlignment="Stretch" IsCompact="True" />

            <!-- Documents follow the selected card, in one vertical reading order. -->
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ListRow" Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="FileList"
                    MaxHeight="240"
                    x:Uid="SignFileList"
                    AutomationProperties.Name="Documente de semnat"
                    ItemsSource="{x:Bind Files}"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:FileRow">
                            <Grid Padding="0,6" ColumnSpacing="12" RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Spacing="8"
                                    Visibility="{x:Bind ErrorVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource DangerBrush}" />
                                    <Button Content="{x:Bind RetryLabel}" Tag="{x:Bind Path}" Click="OnRetryClick" HorizontalAlignment="Left" />
                                </StackPanel>
                                <FontIcon VerticalAlignment="Center" Glyph="&#xE8A5;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Path}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MsCaptionTextStyle}"
                                    Text="{x:Bind SizeText}" />
                                <!-- Format picker: PDF = PAdES-T (default) or XAdES-BES/T/C; other files = XAdES. -->
                                <ComboBox
                                    x:Uid="FileFormat"
                                    Grid.Column="3"
                                    MinWidth="120"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Format semnătură"
                                    ItemsSource="{x:Bind FormatLabels}"
                                    SelectedIndex="{x:Bind FormatIndex, Mode=TwoWay}" />
                                <Button
                                    x:Uid="FileRemove"
                                    Grid.Column="4"
                                    AutomationProperties.Name="Elimină"
                                    Click="OnRemoveClick"
                                    Style="{StaticResource MsIconButtonStyle}"
                                    Tag="{x:Bind Path}">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <controls:DropZone
                    x:Name="DocumentDrop"
                    MinHeight="156"
                    Grid.Row="1"
                    VerticalAlignment="Top" />
            </Grid>

            </StackPanel>
        </ScrollViewer>

        <Expander
            x:Uid="SignAdvanced"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="Opțiuni avansate">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Uid="SignPdfFormat"
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="PDF → PAdES-T (cerut de msign.gov.md); XAdES produce un fișier .xml separat"
                    TextWrapping="Wrap" />
                <RadioButtons
                    x:Name="PackagingButtons"
                    x:Uid="SignPackaging"
                    Header="XAdES"
                    SelectedIndex="0">
                    <RadioButton x:Name="DetachedOption" />
                    <RadioButton x:Name="EnvelopingOption" />
                </RadioButtons>
                <TextBlock
                    x:Uid="SignAlgorithm"
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="Algoritm: SHA-256" />
                <!-- TODO(WIN-01): output policy "Lângă original" / "Alege dosar…" once signing is ported. -->
            </StackPanel>
        </Expander>

        <InfoBar
            x:Name="Result" AutomationProperties.AutomationId="SigningOutcome"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind State.ProgressVisibility, Mode=OneWay}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind State.IsBusy, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource MsCaptionTextStyle}"
                    Text="{x:Bind State.ProgressText, Mode=OneWay}" />
            </StackPanel>
            <controls:StatusLightPill Visibility="{x:Bind State.NotBusyVisibility, Mode=OneWay}" />
            <!-- Style set from code: accent only while enabled (a disabled accent button reads as broken). -->
            <Button
                x:Name="SignButton" AutomationProperties.AutomationId="SignDocuments"
                Grid.Column="1"
                MinWidth="180"
                Click="OnSignClick"
                Content="Semnează"
                IsEnabled="False">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
