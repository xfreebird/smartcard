<?xml version="1.0" encoding="utf-8"?>
<!--
  Activitate: every ActivityRow (status icon, file or site, action, date/time). Document rows are listed only while
  the file exists (pruned when the page is shown) and open signature details; browser requests have no file.
  "Golește lista" clears only history after confirmation; the independent signed-document library stays.
-->
<Page
    x:Class="MoldSign.App.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MoldSign.App.Views"
    xmlns:services="using:MoldSign.App.Services">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="ActivityPageTitle" VerticalAlignment="Center"
                           Style="{StaticResource MsTitleTextStyle}" Text="Documente" />
                <DropDownButton x:Name="ProtectionMenu" Grid.Column="1" AutomationProperties.AutomationId="DocumentsActions">
                    <DropDownButton.Flyout><MenuFlyout>
                        <MenuFlyoutItem x:Name="EncryptMenuItem" Click="OnEncryptClick" />
                        <MenuFlyoutItem x:Name="DecryptMenuItem" Click="OnDecryptClick" />
                        <MenuFlyoutItem x:Name="RemoveMenuItem" Click="OnRemoveClick" />
                    </MenuFlyout></DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ClearButton" Grid.Column="2" AutomationProperties.AutomationId="ClearDocuments"
                        Style="{StaticResource SubtleButtonStyle}" Click="OnClearClick" IsEnabled="False">
                    <FontIcon FontSize="15" Glyph="&#xE74D;" />
                </Button>
            </Grid>
            <ComboBox x:Name="DocumentFilter" AutomationProperties.AutomationId="DocumentFilter" SelectionChanged="OnFilterChanged" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Name="SignedFilter" AutomationProperties.AutomationId="SignedFilter" />
                <ComboBoxItem x:Name="HistoryFilter" AutomationProperties.AutomationId="HistoryFilter" />
            </ComboBox>
        </StackPanel>

        <ListView
            x:Uid="ActivityList"
            Grid.Row="1"
            AutomationProperties.Name="Activitate"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            x:Name="DocumentList"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:ActivityItem">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource BrandBrush}" />
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock AutomationProperties.AutomationId="SavedDocumentName" FontWeight="SemiBold" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind ActionLabel}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind WhenText}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Visibility="{x:Bind FileActionsVisibility}" VerticalAlignment="Center">
                            <views:DocumentFileActions FilePath="{x:Bind Path}" />
                            <Button Click="OnFileActions" Style="{StaticResource SubtleButtonStyle}" Padding="8,5"
                                    AutomationProperties.Name="{x:Bind FileOptionsLabel}" ToolTipService.ToolTip="{x:Bind FileOptionsLabel}"
                                    AutomationProperties.AutomationId="DocumentActions">
                                <FontIcon FontSize="16" Glyph="&#xE712;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyMessage"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource MsCaptionTextStyle}"
            Text="Nicio activitate încă"
            TextWrapping="Wrap" MaxWidth="480" />
    </Grid>
</Page>
