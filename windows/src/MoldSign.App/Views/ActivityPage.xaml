<?xml version="1.0" encoding="utf-8"?>
<!--
  Activitate: every ActivityRow (status icon, file or site, action, date/time). Document rows are listed only while
  the file exists (pruned when the page is shown) and open signature details; browser requests have no file.
  "Golește lista" clears only history after confirmation; the independent signed-document library stays.
-->
<Page
    x:Class="MoldSign.App.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MoldSign.App.Services">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <DropDownButton x:Name="ProtectionMenu" AutomationProperties.AutomationId="DocumentsActions" HorizontalAlignment="Right">
                <DropDownButton.Flyout><MenuFlyout>
                    <MenuFlyoutItem x:Name="EncryptMenuItem" Click="OnEncryptClick" />
                    <MenuFlyoutItem x:Name="DecryptMenuItem" Click="OnDecryptClick" />
                    <MenuFlyoutItem x:Name="RemoveMenuItem" Click="OnRemoveClick" />
                </MenuFlyout></DropDownButton.Flyout>
            </DropDownButton>
            <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock
                x:Uid="ActivityPageTitle"
                VerticalAlignment="Center"
                Style="{StaticResource MsTitleTextStyle}"
                Text="Documente" />
            <Button
                x:Name="ClearButton" AutomationProperties.AutomationId="ClearDocuments"
                Grid.Row="1" HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="OnClearClick"
                IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock x:Uid="ActivityClearLabel" Text="Golește lista" />
                </StackPanel>
            </Button>
        </Grid>
            <ComboBox x:Name="DocumentFilter" AutomationProperties.AutomationId="DocumentFilter" SelectionChanged="OnFilterChanged" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Name="SignedFilter" AutomationProperties.AutomationId="SignedFilter" />
                <ComboBoxItem x:Name="HistoryFilter" AutomationProperties.AutomationId="HistoryFilter" />
            </ComboBox>
        </StackPanel>

        <ListView
            x:Uid="ActivityList"
            Grid.Row="1"
            AutomationProperties.Name="Activitate"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            x:Name="DocumentList"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:ActivityItem">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="{x:Bind Glyph}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock AutomationProperties.AutomationId="SavedDocumentName" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind ActionLabel}" />
                            <Button Content="{x:Bind VerifyLabel}" Visibility="{x:Bind VerifyVisibility}" Click="OnVerifyClick" Margin="0,4,0,0" />
                            <TextBlock Text="{x:Bind OpenLabel}" Foreground="{ThemeResource BrandBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="OnFileActions" Visibility="{x:Bind FileActionsVisibility}" AutomationProperties.AutomationId="DocumentActions">
                                <FontIcon Glyph="&#xE712;" />
                            </Button>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MsCaptionTextStyle}"
                            Text="{x:Bind WhenText}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyMessage"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource MsCaptionTextStyle}"
            Text="Nicio activitate încă"
            TextWrapping="Wrap" MaxWidth="480" />
    </Grid>
</Page>
