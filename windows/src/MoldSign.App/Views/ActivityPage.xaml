<?xml version="1.0" encoding="utf-8"?>
<!--
  Activitate: every ActivityRow (status icon, file or site, action, date/time). Document rows are listed only while
  the file exists (pruned when the page is shown) and reveal it in Explorer; browser requests have no file.
  "Golește lista" clears the log after a confirmation (ContentDialog).
-->
<Page
    x:Class="MoldSign.App.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MoldSign.App.Services">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock
                x:Uid="ActivityPageTitle"
                VerticalAlignment="Center"
                Style="{StaticResource MsTitleTextStyle}"
                Text="Activitate" />
            <Button
                x:Name="ClearButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnClearClick"
                IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    <TextBlock x:Uid="ActivityClearLabel" Text="Golește lista" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView
            x:Uid="ActivityList"
            Grid.Row="1"
            AutomationProperties.Name="Activitate"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind State.Activity}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:ActivityItem">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="{x:Bind Glyph}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind Action}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MsCaptionTextStyle}"
                            Text="{x:Bind WhenText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Uid="RecentEmpty"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource MsCaptionTextStyle}"
            Text="Nicio activitate încă"
            Visibility="{x:Bind State.ActivityEmptyVisibility, Mode=OneWay}" />
    </Grid>
</Page>
