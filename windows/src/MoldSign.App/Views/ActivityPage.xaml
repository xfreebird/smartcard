<?xml version="1.0" encoding="utf-8"?>
<!-- Activitate: ActivityRows (status icon, file, action, time, reveal). -->
<Page
    x:Class="MoldSign.App.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MoldSign.App.Services">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="ActivityPageTitle"
            Style="{StaticResource MsTitleTextStyle}"
            Text="Activitate" />

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind State.Recent}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:ActivityItem">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="{x:Bind Glyph}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind Action}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MsCaptionTextStyle}"
                            Text="{x:Bind WhenText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Uid="RecentEmpty"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource MsCaptionTextStyle}"
            Text="Nicio activitate încă"
            Visibility="{x:Bind State.RecentEmptyVisibility, Mode=OneWay}" />
        <!-- TODO(WIN-04): persist the activity log across sessions (ActivityLog service, docs/09 §1). -->
    </Grid>
</Page>
