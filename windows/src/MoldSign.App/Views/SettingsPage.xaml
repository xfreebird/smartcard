<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (docs/10 §4.2): General, Conexiune browser, Avansat. -->
<Page
    x:Class="MoldSign.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="32,16,32,0">
            <Button x:Name="GeneralTab" Click="OnGeneralTabClick" />
            <Button x:Name="AboutTab" Content="About" Click="OnAboutTabClick" />
        </StackPanel>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1">
        <Grid>
            <StackPanel x:Name="GeneralContent" MaxWidth="720" Padding="{StaticResource PagePadding}"
                HorizontalAlignment="Left" Spacing="16">
            <TextBlock
                x:Uid="SettingsPageTitle" AutomationProperties.AutomationId="SettingsPageTitle"
                Style="{StaticResource MsTitleTextStyle}"
                Text="Setări" />

            <ToggleSwitch x:Name="DemoModeToggle" AutomationProperties.AutomationId="DemoModeToggle" Toggled="OnDemoModeToggled" />
            <TextBlock x:Name="DemoModeDescription" Style="{StaticResource MsCaptionTextStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="DemoModeStatus" Style="{StaticResource MsCaptionTextStyle}" TextWrapping="Wrap" />

            <TextBlock
                x:Uid="SettingsGeneral"
                Style="{StaticResource MsSectionHeaderTextStyle}"
                Text="GENERAL" />
            <!-- Start at sign-in: StartupTask under MSIX, HKCU Run key unpackaged; HKLM (MSI STARTATLOGIN=1) = managed. -->
            <ToggleSwitch
                x:Name="StartAtLoginToggle"
                x:Uid="SettingsStartAtLogin"
                Header="Pornește la autentificare"
                IsEnabled="False"
                Toggled="OnStartAtLoginToggled" />
            <TextBlock
                x:Name="StartAtLoginNote"
                Style="{StaticResource MsCaptionTextStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <ToggleSwitch
                x:Name="ToastsToggle"
                x:Uid="SettingsReaderToasts"
                Header="Notificări la conectarea cititorului"
                Toggled="OnToastsToggled" />
            <ToggleSwitch x:Name="OpenOnInsertionToggle" x:Uid="SettingsOpenOnInsertion"
                Header="Deschide aplicația la introducerea cardului" Toggled="OnOpenOnInsertionToggled" />
            <ToggleSwitch x:Name="OpenOnReaderInsertionToggle" x:Uid="SettingsOpenOnReaderInsertion"
                Header="Deschide la conectarea cititorului" Toggled="OnOpenOnReaderInsertionToggled" />
            <TextBlock x:Name="InsertionHelperStatus" Style="{StaticResource MsCaptionTextStyle}" TextWrapping="Wrap" />
            <ComboBox x:Name="LanguagePicker" x:Uid="SettingsLanguage" Header="Limba" SelectionChanged="OnLanguageChanged">
                <ComboBoxItem x:Uid="SettingsThemeSystem" Content="Sistem" Tag="" />
                <ComboBoxItem Content="Română" Tag="ro-RO" />
                <ComboBoxItem Content="English" Tag="en-US" />
                <ComboBoxItem Content="Русский" Tag="ru-RU" />
            </ComboBox>
            <ComboBox x:Name="ThemePicker" x:Uid="SettingsTheme" Header="Aspect" SelectionChanged="OnThemeChanged">
                <ComboBoxItem x:Uid="SettingsThemeSystem" Content="Sistem" Tag="system" />
                <ComboBoxItem x:Uid="SettingsThemeLight" Content="Luminos" Tag="light" />
                <ComboBoxItem x:Uid="SettingsThemeDark" Content="Întunecat" Tag="dark" />
            </ComboBox>
            <TextBlock x:Uid="SettingsPins" Text="PIN-uri salvate" Style="{StaticResource MsSectionHeaderTextStyle}" />
            <ToggleSwitch x:Name="RememberPinToggle" x:Uid="SettingsRememberPin" Header="Permite salvarea PIN-urilor"
                Toggled="OnRememberPinToggled" />
            <StackPanel x:Name="SavedPinsList" Spacing="8" />
            <Button x:Name="DeleteAllPinsButton" x:Uid="SettingsDeletePins" Content="Șterge toate PIN-urile salvate" Click="OnDeletePinsClick" />
            <TextBlock x:Name="PinsStatus" Style="{StaticResource MsCaptionTextStyle}" />

            <TextBlock
                x:Uid="SettingsBridge"
                Style="{StaticResource MsSectionHeaderTextStyle}"
                Text="CONEXIUNE BROWSER" />
            <ToggleSwitch
                x:Name="BridgeToggle"
                x:Uid="SettingsBridgeToggle"
                Header="Conexiune browser (compatibilă MoldSign Server)"
                IsOn="{x:Bind State.BridgeEnabled, Mode=OneWay}"
                Toggled="OnBridgeToggled" />
            <TextBlock Style="{StaticResource MsCaptionTextStyle}" Text="{x:Bind State.BridgeStatus, Mode=OneWay}" />
            <ToggleSwitch x:Name="BrowserStampsToggle" Toggled="OnBrowserStampsToggled" />
            <TextBlock x:Name="StampBatchHint" TextWrapping="Wrap" />
            <ToggleSwitch x:Name="LegacyClientToggle" Toggled="OnLegacyClientToggled" />
            <TextBlock x:Name="LegacyClientDescription" TextWrapping="Wrap" />
            <Button x:Name="ResolveBridgeButton" Click="OnResolveBridgeClick" />
            <TextBlock
                Style="{StaticResource MsCaptionTextStyle}"
                Text="http://127.0.0.1:18480 · https://localhost.cts.md:18443"
                IsTextSelectionEnabled="True" />
            <TextBlock
                x:Name="AllowedSitesText"
                Style="{StaticResource MsCaptionTextStyle}" />
            <Button
                x:Uid="SettingsImportIdentity"
                Click="OnImportIdentityClick"
                Content="Importă identitatea HTTPS (localhost.p12)…" />

            <TextBlock
                x:Uid="SettingsAdvanced"
                Style="{StaticResource MsSectionHeaderTextStyle}"
                Text="AVANSAT" />
            <!-- TODO(WIN-04): diagnostics export (no PIN, no session keys: SEC-04) and reset. -->
            </StackPanel>
            <StackPanel x:Name="AboutContent" MaxWidth="720" Padding="{StaticResource PagePadding}"
                HorizontalAlignment="Center" Spacing="16" Visibility="Collapsed">
                <TextBlock x:Name="AboutTitle" HorizontalAlignment="Center" Style="{StaticResource MsTitleTextStyle}" />
                <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" Width="96" Height="96" Stretch="Uniform" />
                <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Style="{StaticResource MsCaptionTextStyle}" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="AboutDeveloper" HorizontalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <HyperlinkButton HorizontalAlignment="Center" Content="esemnbun.md" NavigateUri="https://esemnbun.md" />
                <Button x:Name="CheckUpdatesButton" HorizontalAlignment="Center" Visibility="Collapsed" Click="OnCheckUpdatesClick" />
                <TextBlock x:Name="UpdateStatus" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
