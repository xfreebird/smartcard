    "protect_removal_warning": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierul selectat va fi suprascris, unde este posibil, apoi eliminat. Pot rămâne urme pe SSD, instantanee, copii de rezervă și alte copii. Acțiunea este ireversibilă."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This overwrites the selected file where supported, then removes it. SSD remnants, snapshots, backups and other copies may remain. This cannot be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный файл будет перезаписан, где это возможно, затем удалён. Данные на SSD, снимки, резервные и другие копии могут сохраниться. Отменить действие нельзя."
          }
        }
      }
    },
