    "about_disclaimer_body": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "eSemnBun este un proiect independent, neafiliat Guvernului Republicii Moldova sau STISC. Nu emite certificate și nu oferă consultanță juridică. Consultă termenii pentru informații despre garanții, responsabilități și riscuri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "eSemnBun is an independent project, not affiliated with the Government of Moldova or STISC. It does not issue certificates or provide legal advice. See the terms for warranties, responsibilities and risks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "eSemnBun — независимый проект, не связанный с Правительством Молдовы или STISC. Он не выдаёт сертификаты и не предоставляет юридических консультаций. Гарантии, обязанности и риски описаны в условиях использования."
          }
        }
      }
    },
