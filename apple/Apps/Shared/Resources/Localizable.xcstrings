          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe horizontally or use the arrows to choose a card. Touch and hold to read it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по горизонтали или используйте стрелки, чтобы выбрать карту. Нажмите и удерживайте, чтобы считать её снова."
