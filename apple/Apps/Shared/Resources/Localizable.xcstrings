            "state": "translated",
            "value": "Находить подписанные документы в Siri и Spotlight"
          }
        }
      }
    },
    "discovery_explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares filenames and dates of app-owned signed documents with Siri and Spotlight, and recent filenames with the Home Screen widget. Document contents and identity details are not shared."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajează numele și datele documentelor semnate cu Siri și Spotlight, iar numele recente cu widgetul de pe ecranul principal. Conținutul și datele de identitate nu sunt partajate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаёт имена и даты подписанных документов Siri и Spotlight, а недавние имена — виджету главного экрана. Содержимое и личные данные не передаются."
          }
        }
      }
    },
    "automation_title": {
      "localizations": {
