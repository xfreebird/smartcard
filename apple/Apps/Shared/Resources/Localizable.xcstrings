    "shortcut_verify_pdf_description": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică semnăturile PDF offline și deschide rezultatele complete. Sunt acceptate fișiere PDF de până la 32 MiB. Starea actuală de revocare a certificatelor nu este verificată. Dacă nu este furnizat un fișier, alege un PDF din selectorul de fișiere al aplicației."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check PDF signatures offline and open the full results. PDFs up to 32 MiB are supported. This does not check current certificate revocation status. If no file is supplied, choose a PDF in the app’s file picker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить подписи PDF автономно и открыть полные результаты. Поддерживаются PDF размером до 32 МиБ. Текущий статус отзыва сертификатов не проверяется. Если файл не передан, выберите PDF в окне выбора файлов приложения."
          }
        }
      }
    },
