          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar app detects your card. Enable launch at login to keep it available."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение в строке меню обнаруживает карту. Включите запуск при входе в систему, чтобы оно всегда было доступно."
          }
        }
      }
    },
