    "shortcut_prepare_description": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un PDF de până la 32 MiB în lista de semnare. Verifică documentul și pornește explicit semnarea în aplicație. Dacă nu este furnizat un fișier, alege un PDF din selectorul de fișiere al aplicației."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a PDF up to 32 MiB to the signing queue. Review the document and explicitly sign in the app. If no file is supplied, choose a PDF in the app’s file picker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет PDF размером до 32 МиБ в очередь. Проверьте документ и явно начните подписание в приложении. Если файл не передан, выберите PDF в окне выбора файлов приложения."
          }
        }
      }
    },
    "shortcut_document": {
      "localizations": {
