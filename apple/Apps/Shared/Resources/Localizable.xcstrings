    "automation_approve_details": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un client local de automatizare solicită o semnătură PAdES-T. Verifică PDF-ul înainte de aprobare.\n\nDocument: %@\nIdentitate: %@\nSHA-256 document: %@\nSHA-256 certificat: %@\n\nPDF-ul semnat va fi returnat clientului solicitant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local automation client requests a PAdES-T signature. Review the PDF before approving.\n\nDocument: %@\nIdentity: %@\nDocument SHA-256: %@\nCertificate SHA-256: %@\n\nThe signed PDF will be returned to the requesting client."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный клиент автоматизации запрашивает подпись PAdES-T. Проверьте PDF перед одобрением.\n\nДокумент: %@\nЛичность: %@\nSHA-256 документа: %@\nSHA-256 сертификата: %@\n\nПодписанный PDF будет возвращён запрашивающему клиенту."
          }
        }
      }
    },
