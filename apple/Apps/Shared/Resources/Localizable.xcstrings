    "discovery_enable": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește documentele semnate în Siri și Spotlight"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find signed documents in Siri and Spotlight"
          }
        },
        "ru": {
