      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcționează cu orice iPhone cu iOS 17 sau o versiune ulterioară și cu orice iPad cu iPadOS 17 sau o versiune ulterioară. Alege adaptorul potrivit pentru portul dispozitivului. De regulă, nu este necesară o sursă de alimentare externă."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with any iPhone running iOS 17 or later and any iPad running iPadOS 17 or later. Choose the adapter that matches your device’s port. External power is generally not needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает с любым iPhone под управлением iOS 17 или новее и любым iPad с iPadOS 17 или новее. Выберите адаптер для разъёма вашего устройства. Внешнее питание обычно не требуется."
          }
        }
      }
