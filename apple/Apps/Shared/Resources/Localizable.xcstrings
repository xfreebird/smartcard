    "pin_shared_channels": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Același PIN salvat este folosit prin NFC și prin cititor pentru acest card. Îl deblochezi cu Face ID, Touch ID sau codul dispozitivului. Ștergerea se aplică ambelor metode."
          }
        },
        "en": {
          "stringUnit": {
