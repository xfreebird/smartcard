    "ui_the_menu_bar_app_detects_your_card_enable_launch_at_login_to_keep_it_available": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația din bara de meniu detectează cardul. Activează pornirea la autentificare pentru a o păstra disponibilă."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar app detects your card. Enable launch at login to keep it available."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение в строке меню обнаруживает карту. Включите запуск при входе в систему, чтобы оно всегда было доступно."
          }
        }
      }
    },
