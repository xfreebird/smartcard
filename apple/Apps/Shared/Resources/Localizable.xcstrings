            "value": "Înregistrarea rămâne în Documente. Restabilește fișierul în locația inițială, apoi redeschide detaliile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry remains in Documents. Restore the file to its original location, then reopen the details."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись остаётся в Документах. Восстановите файл в исходном месте и снова откройте сведения."
          }
        }
      }
    },
    "saved_xml_hint": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru verificarea sau partajarea unei semnături XML detașate este necesar și documentul original. Un original lipsă nu dovedește modificarea documentului."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A detached XML signature also needs its original document for verification or sharing. A missing original does not prove that the document was modified."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для проверки или отправки отделённой XML-подписи нужен исходный документ. Отсутствие оригинала не доказывает изменение документа."
          }
        }
      }
    },
