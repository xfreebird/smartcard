    "ui_swipe_horizontally_or_use_the_arrows_to_choose_a_card_right_click_to_read_it_again": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează orizontal sau folosește săgețile pentru a alege cardul. Clic dreapta pentru a-l reciti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe horizontally or use the arrows to choose a card. Right-click to read it again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по горизонтали или используйте стрелки, чтобы выбрать карту. Нажмите правой кнопкой мыши, чтобы считать её снова."
          }
        }
      }
    },
    "ui_swipe_horizontally_or_use_the_arrows_to_choose_a_card_touch_and_hold_to_read_it_again": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
