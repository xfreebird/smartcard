    "automation_hint": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare cerere necesită verificarea PDF-ului și aprobarea în eSemnBun. PIN-ul rămâne în aplicație. Dezactivează pentru a respinge cererile în așteptare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every request requires a PDF review and approval in eSemnBun. PINs stay in the app. Turn this off to reject pending requests."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый запрос требует проверки PDF и одобрения в eSemnBun. PIN остаётся в приложении. Отключите, чтобы отклонить ожидающие запросы."
          }
        }
      }
    },
