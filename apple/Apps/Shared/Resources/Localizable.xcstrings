    "nfc_card_title": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Semnează cu cartea de identitate"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign with your identity card"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпишите удостоверением личности"
          }
        }
      }
    },
    "nfc_signing_instructions": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege documentele și confirmă PIN-ul. Apoi ține cardul lângă partea de sus a iPhone-ului până la confirmarea finală. O singură apropiere pentru fiecare document."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your documents and confirm your PIN. Then hold your card against the top of your iPhone until the final confirmation. One tap for each document."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите документы и подтвердите PIN. Затем держите карту у верхней части iPhone до окончательного подтверждения. Одно прикладывание для каждого документа."
          }
        }
      }
    },
    "nfc_unavailable": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC nu este disponibil pe acest dispozitiv. Folosește un cititor de carduri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is unavailable on this device. Use a card reader."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC недоступен на этом устройстве. Используйте картридер."
          }
        }
      }
    },
    "nfc_connection_lost": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea NFC s-a întrerupt. Apasă din nou Semnează și ține cardul nemișcat până la confirmarea finală."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The NFC connection ended. Tap Sign again and keep the card still until the final confirmation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение NFC прервано. Нажмите «Подписать» снова и держите карту неподвижно до окончательного подтверждения."
          }
        }
      }
    },
    "nfc_one_card": {
